{
  "name": "@secure-t/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Campus AURUM de secure T: web elevada con agente IA integrado, voz humanizada, calendario por país y cuatro idiomas (PT/ES/EN/CA).",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "build:static": "NEXT_OUTPUT=export next build",
    "build:pages": "node ../../tools/web-build-pages.mjs",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "content": "tsx ../../tools/build-content.ts"
  },
  "dependencies": {
    "@secure-t/agent": "workspace:*",
    "@secure-t/shared": "workspace:*",
    "@secure-t/ui": "workspace:*",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
