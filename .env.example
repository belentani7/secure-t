# Entorno de Producción - Variables de configuración obligatorias.
# Copia este archivo como .env y rellena los valores correspondientes en tu entorno seguro.

NODE_ENV=production
PORT=3000

# Base de datos y servicios de almacenamiento (requeridos para persistencia real)
POSTGRES_USER=securet
POSTGRES_PASSWORD=cambiar_password_segura_postgresql
POSTGRES_DB=securet_prod

MINIO_ROOT_USER=securet_admin
MINIO_ROOT_PASSWORD=cambiar_password_segura_minio

# Integración opcional de tutor Express y LLM (mantener secreto en servidor)
SECURE_T_TUTOR_API_KEY=cambiar_api_key_secreta
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b