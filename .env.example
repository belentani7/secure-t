# Runtime
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Public metadata (not secret)
SITE_URL=https://www.belentani.es/secure-t

# Optional tutor integration; server-side only, never expose in the SPA
SECURE_T_TUTOR_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Shared rate limiting (required when tutor is public; keep credentials server-side)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Observability (optional)
SENTRY_DSN=
LOG_LEVEL=info

# Local services only
POSTGRES_USER=securet
POSTGRES_PASSWORD=
POSTGRES_DB=securet
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
