{
  "name": "secure-t",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "tsx index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "content": "tsx tools/build-content.ts",
    "web:dev": "pnpm --filter @secure-t/web dev",
    "web:build": "pnpm --filter @secure-t/web build",
    "web:typecheck": "pnpm --filter @secure-t/web typecheck",
    "site": "node tools/build-site.mjs",
    "site:clasico": "node tools/build-site.mjs --clasico",
    "serve:site": "node tools/serve-static.mjs --port 4173",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "playwright test",
    "storybook": "pnpm --filter @secure-t/ui storybook",
    "audit:site": "node tools/audit-site.mjs --dir apps/web/out --base /app",
    "check": "pnpm typecheck && pnpm test && pnpm audit:site",
    "syllabus": "tsx tools/build-syllabus.ts",
    "content:all": "pnpm content && pnpm syllabus && pnpm packages && pnpm sbom",
    "packages": "tsx tools/build-packages.ts",
    "sbom": "node tools/build-sbom.mjs",
    "audit:deps": "node tools/audit-deps.mjs",
    "check:drift": "node tools/check-drift.mjs",
    "locales": "tsx tools/report-locales.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.22.3",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.49.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "wouter": "^3.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/google.maps": "^3.66.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "@axe-core/playwright": "^4.11.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.0",
    "@vitest/coverage-v8": "^5.0.2"
  },
  "pnpm": {
    "overrides": {
      "tmp@<0.2.6": "^0.2.6",
      "basic-ftp@<6.2.1": "^6.2.1",
      "source-map-js@<1.2.2": "^1.2.2",
      "uuid@<11.1.1": "^11.1.1",
      "storybook>@vitest/mocker": "^4.1.11",
      "@puppeteer/browsers@<3.2.4": "^3.2.4"
    }
  }
}
