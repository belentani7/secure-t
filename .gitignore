# secure-t — .gitignore (sitio estático + scripts Python)
# Secretos: nunca en el repo
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
# Bases de datos locales (usar scripts de semilla)
*.db
*.sqlite
*.sqlite3
# Perfiles de navegador / artefactos de QA
.duck-qa/
*-profile*/
playwright-report/
test-results/
# Dependencias y builds
node_modules/
dist/
build/
.next/
.vercel/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
# Logs y volcados de terminal
*.log
*_terminal*.txt
pasted_*
# SO / editores
.DS_Store
Thumbs.db
.idea/
.vscode/
