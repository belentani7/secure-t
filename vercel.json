{
  "version": 2,
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "vite",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/enroll", "destination": "/index.html" },
    { "source": "/courses", "destination": "/index.html" },
    { "source": "/lesson/:id", "destination": "/index.html" },
    { "source": "/record", "destination": "/index.html" },
    { "source": "/credentials", "destination": "/index.html" },
    { "source": "/research", "destination": "/index.html" },
    { "source": "/faculty", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/notifications", "destination": "/index.html" },
    { "source": "/404", "destination": "/index.html" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
